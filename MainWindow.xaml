<Window x:Class="FlareWall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Topmost="True">

    <Grid>

        <StackPanel
            VerticalAlignment="Center"
            HorizontalAlignment="Center">

            <TextBlock
                x:Name="FunctionText"
                FontSize="32"
                Margin="0,0,0,20"/>

            <TextBlock
                x:Name="ParameterText"
                FontSize="24"
                Margin="0,0,0,20"/>

            <TextBox
                x:Name="AnswerBox"
                Width="250"
                Height="40"
                Margin="0,0,0,20"/>

            <Button
                Width="250"
                Height="40"
                Content="Unlock"
                Click="Unlock_Click"/>

        </StackPanel>

    </Grid>

</Window>